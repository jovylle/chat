# Secrets for the Cloudflare Worker. A model whose provider key is unset is
# hidden/disabled in the UI rather than erroring.
#
# Local dev (`wrangler dev`): copy these into a `.dev.vars` file at the repo root
#   (gitignored). Production: set each with `wrangler secret put <NAME>`.
#
# Spend safety: set a cap in each provider's own dashboard. There is no
# per-request rate limiter server-side by design.

MY_OPENAI_API=your_openai_api_key_here
MY_GEMINI_API=your_gemini_api_key_here
MY_DEEPSEEK_API=your_deepseek_api_key_here
MY_QWEN_API=your_qwen_dashscope_api_key_here
MY_GLM_API=your_zai_glm_api_key_here

# HMAC pepper for password hashing / session tokens (Phase 2+). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_hex_secret_here
