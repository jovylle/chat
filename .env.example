# Provider API keys — set the ones you want enabled. A model whose key is
# unset is hidden/disabled in the UI rather than erroring.
# For local dev with `npx netlify dev`, put these in a `.env` file at the repo root.
# In production, set them in Netlify → Site settings → Environment variables.
#
# Spend safety: set a cap in each provider's own dashboard. There is no
# per-request rate limiter server-side by design.

MY_OPENAI_API=your_openai_api_key_here
MY_GEMINI_API=your_gemini_api_key_here
MY_DEEPSEEK_API=your_deepseek_api_key_here
MY_QWEN_API=your_qwen_dashscope_api_key_here
MY_GLM_API=your_zai_glm_api_key_here
